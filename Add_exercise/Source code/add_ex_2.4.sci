n = -2:2;
xn = [2, 3, 4, 5, 6];
x_fold = xn($:-1:1);
xe = 0.5 * (xn + x_fold);
xo = 0.5 * (xn - x_fold);
disp("Thành phần chẵn xe(n):"); disp(xe);
disp("Thành phần lẻ xo(n):"); disp(xo);
scf(3); clf();
subplot(3,1,1); 
plot2d3(n, xn, style=color("blue")); e=gce(); e.children.thickness=3; 
xtitle("Tín hiệu gốc x(n)"); xgrid();
subplot(3,1,2); 
plot2d3(n, xe, style=color("magenta")); e=gce(); e.children.thickness=3; 
xtitle("Thành phần chẵn xe(n)"); xgrid();
subplot(3,1,3); 
plot2d3(n, xo, style=color("red")); e=gce(); e.children.thickness=3; 
xtitle("Thành phần lẻ xo(n)"); xgrid();
xs2png(3, "Bai2_4.png");
disp(">> Đã lưu ảnh Bai2_4.png");
